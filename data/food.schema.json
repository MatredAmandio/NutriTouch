{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NutriTouch Food Schema V2",
  "type": "object",
  "required": [
    "id",
    "name",
    "group",
    "processing_level",
    "nutrition",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "group": {
      "type": "string"
    },
    "food_state": {
      "type": "string"
    },
    "processing_level": {
      "enum": [
        "in_natura",
        "minimally_processed",
        "culinary_ingredient",
        "processed",
        "ultra_processed"
      ]
    },
    "nutrition": {
      "$ref": "./nutrients.schema.json"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "record_id",
          "status"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "record_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "enum": [
              "verified",
              "pending_import",
              "quarantined",
              "derived_recipe"
            ]
          },
          "accessed_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "diet_compatibility": {
      "type": "object"
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allergens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "household_measures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "grams"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "grams": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}